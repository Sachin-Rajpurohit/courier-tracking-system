{
  "info": {
    "name": "Courier Tracking System",
    "description": "Run 'Log in as admin' first; it saves the token for the other requests. Run the requests in the Workflow folder from top to bottom for a full delivery. Requires the seeded demo data.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "customerId",
      "value": ""
    },
    {
      "key": "agentId",
      "value": ""
    },
    {
      "key": "senderAddressId",
      "value": ""
    },
    {
      "key": "receiverAddressId",
      "value": ""
    },
    {
      "key": "addressId",
      "value": ""
    },
    {
      "key": "shipmentId",
      "value": ""
    },
    {
      "key": "trackingNumber",
      "value": ""
    },
    {
      "key": "eventId",
      "value": ""
    },
    {
      "key": "assignmentId",
      "value": ""
    },
    {
      "key": "attemptId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Log in as admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@courier.test\",\n  \"password\": \"Admin@1234\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) pm.collectionVariables.set('token', json.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Log in as staff",
