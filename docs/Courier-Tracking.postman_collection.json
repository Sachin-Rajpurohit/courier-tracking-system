    {
      "name": "Workflow (log in as admin or staff first)",
      "item": [
        {
          "name": "1. Find the demo customer",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users?role=customer&q=customer@courier.test",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ],
              "query": [
                {
                  "key": "role",
                  "value": "customer"
                },
                {
                  "key": "q",
                  "value": "customer@courier.test"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('customerId', json.items[0]._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Find the demo agent",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users?role=agent&q=agent@courier.test",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ],
              "query": [
                {
                  "key": "role",
                  "value": "agent"
                },
                {
                  "key": "q",
                  "value": "agent@courier.test"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('agentId', json.items[0]._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Add sender address",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/addresses",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "addresses"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"owner\": \"{{customerId}}\",\n  \"label\": \"Postman sender\",\n  \"contactName\": \"Sample Contact\",\n  \"phone\": \"+91 98000 00000\",\n  \"line1\": \"1 Sample Street\",\n  \"city\": \"Jaipur\",\n  \"state\": \"Rajasthan\",\n  \"postalCode\": \"302001\",\n  \"country\": \"India\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (pm.response.code < 300 && json._id) pm.collectionVariables.set('senderAddressId', json._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "4. Add receiver address",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/addresses",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "addresses"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"owner\": \"{{customerId}}\",\n  \"label\": \"Postman receiver\",\n  \"contactName\": \"Sample Contact\",\n  \"phone\": \"+91 98000 00000\",\n  \"line1\": \"1 Sample Street\",\n  \"city\": \"Pune\",\n  \"state\": \"Rajasthan\",\n  \"postalCode\": \"302001\",\n  \"country\": \"India\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (pm.response.code < 300 && json._id) pm.collectionVariables.set('receiverAddressId', json._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "5. Create shipment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/shipments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "shipments"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer\": \"{{customerId}}\",\n  \"senderAddress\": \"{{senderAddressId}}\",\n  \"receiverAddress\": \"{{receiverAddressId}}\",\n  \"description\": \"Sample parcel\",\n  \"weightKg\": 2.5,\n  \"serviceType\": \"express\",\n  \"originBranch\": \"Jaipur Hub\",\n  \"expectedDeliveryDate\": \"2030-01-15\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('shipmentId', json._id);",
                  "pm.collectionVariables.set('trackingNumber', json.trackingNumber);"
                ]
              }
            }
          ]
        },
        {
          "name": "6. Assign agent",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/assignments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "assignments"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"trackingNumber\": \"{{trackingNumber}}\",\n  \"agent\": \"{{agentId}}\",\n  \"note\": \"Priority route\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (pm.response.code < 300 && json._id) pm.collectionVariables.set('assignmentId', json._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "7. Checkpoint: picked up",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/tracking-events",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tracking-events"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"trackingNumber\": \"{{trackingNumber}}\",\n  \"status\": \"picked_up\",\n  \"location\": \"Jaipur Hub\",\n  \"note\": \"Collected\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (pm.response.code < 300 && json._id) pm.collectionVariables.set('eventId', json._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "8. Checkpoint: in transit",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/tracking-events",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tracking-events"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"trackingNumber\": \"{{trackingNumber}}\",\n  \"status\": \"in_transit\",\n  \"location\": \"Nagpur Sorting Centre\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (pm.response.code < 300 && json._id) pm.collectionVariables.set('eventId', json._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "9. Checkpoint: out for delivery",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/tracking-events",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tracking-events"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"trackingNumber\": \"{{trackingNumber}}\",\n  \"status\": \"out_for_delivery\",\n  \"location\": \"Pune Hub\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (pm.response.code < 300 && json._id) pm.collectionVariables.set('eventId', json._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "10. Record failed attempt",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/delivery-attempts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "delivery-attempts"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"trackingNumber\": \"{{trackingNumber}}\",\n  \"outcome\": \"failed\",\n  \"failureReason\": \"recipient_unavailable\",\n  \"location\": \"Pune\",\n  \"note\": \"Nobody home\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "11. Checkpoint: back out for delivery",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/tracking-events",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tracking-events"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"trackingNumber\": \"{{trackingNumber}}\",\n  \"status\": \"out_for_delivery\",\n  \"location\": \"Pune Hub\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "12. Record successful attempt",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/delivery-attempts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "delivery-attempts"
