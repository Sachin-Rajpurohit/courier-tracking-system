        {
          "name": "13. See the public tracking page data",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/track/{{trackingNumber}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "track",
                "{{trackingNumber}}"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "List users",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users?page=1&limit=10&sort=name&q=&role=&active=true",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ],
              "query": [
                {
                  "key": "page",
                  "value": 1
                },
                {
                  "key": "limit",
                  "value": 10
                },
                {
                  "key": "sort",
                  "value": "name"
                },
                {
                  "key": "q",
                  "value": ""
                },
                {
                  "key": "role",
                  "value": ""
                },
                {
                  "key": "active",
                  "value": "true"
                }
              ]
            }
          }
        },
        {
          "name": "Create user (admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ]
            },
